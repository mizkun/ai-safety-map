{
  "name": "ai-safety-map",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run check:content && vinext build && node scripts/prepare-pages.mjs",
    "start": "vinext start",
    "lint": "oxlint app lib scripts next.config.ts vite.config.ts",
    "format": "oxfmt",
    "check:content": "node scripts/validate-content.mjs",
    "check": "npm run check:content && npm run test:freshness && tsc --noEmit && npm run lint",
    "check:freshness": "node scripts/check-freshness.mjs",
    "test:freshness": "node --test scripts/freshness.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "type": "module",
  "license": "MIT",
  "homepage": "https://mizkun.github.io/ai-safety-map/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mizkun/ai-safety-map.git"
  }
}
