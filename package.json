{
  "name": "ai-safety-map",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-content.mjs && vinext dev",
    "build": "npm run check:content && npm run check:logic && node scripts/prepare-content.mjs && vinext build && node scripts/prepare-pages.mjs",
    "start": "vinext start",
    "lint": "oxlint app lib scripts next.config.ts vite.config.ts",
    "format": "oxfmt",
    "check:content": "node scripts/validate-content.mjs && node scripts/validate-locales.mjs",
    "check": "npm run check:content && npm run check:logic && npm run test:logic && npm run test:content-package && npm run test:freshness && npm run test:locales && npm run test:map && npm run test:navigation && tsc --noEmit && npm run lint",
    "check:freshness": "node scripts/check-freshness.mjs",
    "test:freshness": "node --test scripts/freshness.test.mjs",
    "i18n:export": "node scripts/export-translation.mjs",
    "test:map": "node --experimental-strip-types --test scripts/map/*.test.mjs",
    "test:navigation": "node --experimental-strip-types --test scripts/map-navigation.test.mjs",
    "check:logic": "node scripts/check-logic.mjs",
    "test:logic": "node --test scripts/logic.test.mjs",
    "review:draft": "node scripts/draft-review.mjs",
    "review:reading": "node --experimental-strip-types scripts/export-reading-review.mjs",
    "test:content-package": "node --test scripts/content-package.test.mjs",
    "test:locales": "node --test scripts/translation.test.mjs"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.4.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "type": "module",
  "license": "MIT",
  "homepage": "https://ai-safety-map.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mizkun/ai-safety-map.git"
  }
}
